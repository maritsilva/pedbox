# Copie para .env. Não coloque segredos em VITE_*.
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
# Login administrativo fixo EXCLUSIVO para desenvolvimento local. Desative em produção.
DEV_AUTH=true
DATA_DIR=.data/postgres
UPLOAD_DIR=.data/uploads
# Em produção: NODE_ENV=production, APP_ORIGIN=https://seu-dominio, DEV_AUTH=false
# PostgreSQL externo obrigatório em produção; PGlite persistente no desenvolvimento.
DATABASE_URL=
# OIDC: cadastrar callback https://seu-dominio/api/v1/auth/callback no provedor.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Destinatário fixo no servidor; a API não aceita destinatário do navegador.
SMTP_URL=
MAIL_FROM=
CONTACT_TO=dramarinasilvaped@gmail.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AI_WEB_SEARCH=true

# RCPCH Digital Growth Charts — secret server-side subscription key
RCPCH_API_KEY=
