{
  "name": "LinkBiblioteca",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do link"
    },
    "url": {
      "type": "string",
      "description": "URL do link ou arquivo"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o breve"
    },
    "categoria": {
      "type": "string",
      "description": "Categoria do link"
    },
    "icone": {
      "type": "string",
      "description": "Emoji \u00edcone"
    }
  },
  "required": [
    "titulo",
    "url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}